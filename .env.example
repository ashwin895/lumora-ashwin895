# Copy to .env and fill in. Never commit .env.
# Example: Groq (free tier) at https://console.groq.com
API_KEY=your-free-provider-key
BASE_URL=https://api.groq.com/openai/v1
MODEL=llama-3.3-70b-versatile
# Used automatically when a message includes an image. Must be a vision-capable model.
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
PORT=3000
